{
  "manifest_version": 3,
  "name": "AniTrack Core",
  "version": "12.0.0",
  "description": "Fault-tolerant, high-performance Manifest V3 anime progress tracker.",
  "permissions": [
    "storage",
    "alarms",
    "activeTab"
  ],
  "host_permissions": [
    "https://api.myanimelist.net/*",
    "https://graphql.anilist.co/*",
    "https://api.ani.zip/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/observer.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html"
  }
}
