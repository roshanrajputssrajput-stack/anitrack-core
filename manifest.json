{
  "manifest_version": 3,
  "name": "AniTrack",
  "version": "12.1.0",
  "key": "",
  "description": "Track your anime watching history. Auto-detects title and episode from any streaming site. Syncs with MyAnimeList.",
  "permissions": ["activeTab", "storage", "tabs", "scripting", "downloads", "notifications", "identity", "alarms", "webNavigation", "idle"],
  "host_permissions": [
    "https://api.myanimelist.net/*",
    "https://myanimelist.net/*",
    "https://api.jikan.moe/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_badge_text": ""
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
